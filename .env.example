# =============================================================================
# AgentOps-SRE Configuration Template (v0.8.0)
# Copy this file to .env and customize as needed for your environment.
# All sensitive values (API keys, credentials) must remain strictly in .env.
# NEVER commit real credentials or API keys to version control.
# =============================================================================

# Server Bind Address (Default: 127.0.0.1 for local developer security)
AGENTOPS_HOST=127.0.0.1
AGENTOPS_PORT=8000

# Local Kubernetes Cluster Configuration
CLUSTER_NAME=agentops
# KUBECONFIG can point to a file, or leave blank to auto-detect ~/.kube/config or in-cluster auth
KUBECONFIG=
DEMO_NAMESPACE=demo
MONITORING_NAMESPACE=monitoring

# Infrastructure Telemetry & Dashboard Endpoints
PROMETHEUS_URL=http://localhost:30090
LOKI_URL=http://localhost:31000
GRAFANA_URL=http://localhost:30300
ALERTMANAGER_URL=http://localhost:30093
DEMO_APP_URL=http://localhost:30080

# LLM Provider Configuration
# Supported providers: 'ollama' (default for local SRE), 'openai', 'gemini'
# MOCK RCA is strictly forbidden in live investigations.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:2b
OLLAMA_URL=http://localhost:11434

# Cloud LLM Credentials (Optional - leave empty when using local Ollama)
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Timeouts & Limits (Seconds & Row Counts)
LLM_TIMEOUT_SECONDS=300
TELEMETRY_TIMEOUT_SECONDS=5
LOGS_LIMIT=50
EVENTS_LIMIT=30

# Asynchronous Investigation Worker & Queue Configuration
MAX_CONCURRENT_INVESTIGATIONS=1
JOB_LEASE_SECONDS=120
JOB_QUEUE_MAX_SIZE=100
IN_PROCESS_WORKER=true

# Alertmanager Webhook & Deduplication Configuration
# Optional shared secret checked via X-Alertmanager-Secret header or ?secret= query parameter
ALERTMANAGER_SECRET=
ALERT_COOLDOWN_SECONDS=300

# Email Notification Configuration (Alertmanager outcome notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agentops-sre@localhost
NOTIFICATION_EMAIL_TO=

# File Paths & Data Directories (Resolved portably relative to project root)
AGENTOPS_DATA_DIR=data
AGENTOPS_DB_PATH=data/agentops.db
POLICIES_PATH=config/policies.yaml

# Logging & OpenTelemetry Observability
LOG_LEVEL=INFO
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
