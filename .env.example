# Cluster Configuration
CLUSTER_NAME=agentops
KUBECONFIG_PATH=~/.kube/config

# Namespaces
DEMO_NAMESPACE=demo
MONITORING_NAMESPACE=monitoring

# Port Mappings (Host access)
DEMO_APP_PORT=30080
PROMETHEUS_PORT=30090
GRAFANA_PORT=30300
LOKI_PORT=31000

# Demo App Config
DEMO_APP_REPLICAS=2

# LLM Provider Configuration
# Options: 'gemini', 'openai' (for local LLMs via Ollama/vLLM/LM Studio), 'mock'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Google Gemini API
GEMINI_API_KEY=

# Local LLM / OpenAI Compatible (e.g. Ollama http://localhost:11434/v1)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

